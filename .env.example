# Required for the `ask` command.
OPENAI_API_KEY=replace-me

# Optional for OpenAI-compatible providers.
OPENAI_BASE_URL=
MODEL_NAME=gpt-4.1-mini
# Maximum wait for one chat-model HTTP request.
MODEL_REQUEST_TIMEOUT_SECONDS=120

# Graph-only generation limits; timeout/retry changes preserve completed batches.
# Without this override, graph timeout defaults to max(180, MODEL_REQUEST_TIMEOUT_SECONDS).
NOVEL_AGENT_GRAPH_REQUEST_TIMEOUT_SECONDS=180
# Extra attempts for small extraction windows and entity resolution after a timeout (0-3).
# Larger extraction windows are split instead of repeating the oversized request.
NOVEL_AGENT_GRAPH_REQUEST_RETRIES=1
# Truncated graph extraction responses trigger smaller windows (512-16384).
NOVEL_AGENT_GRAPH_MAX_OUTPUT_TOKENS=6144
# Independent extraction windows / dependency groups (1-16; use 1 for serial).
NOVEL_AGENT_GRAPH_EXTRACTION_CONCURRENCY=4
NOVEL_AGENT_GRAPH_RESOLUTION_CONCURRENCY=4
# Extra attempts after HTTP 429 (0-5); workers share the provider cooldown.
NOVEL_AGENT_GRAPH_RATE_LIMIT_RETRIES=3

# Optional hybrid retrieval capability. It stays off until enabled in the UI,
# unless a complete cache for the current novel/model already exists.
# Leave EMBEDDING_MODEL empty to keep the UI switch unavailable and use BM25 only.
# API key and base URL fall back to OPENAI_API_KEY / OPENAI_BASE_URL.
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Embedding queries fall back to BM25 after this timeout.
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

# Disable reasoning for Agent tool-calling. Qwen uses enable_thinking=false;
# DeepSeek and compatible providers use thinking.type=disabled.
# Also accepts off/false, on/true, enabled, auto, or blank.
MODEL_THINKING_MODE=

# Optional runtime defaults.
NOVEL_AGENT_DATA_DIR=output
NOVEL_AGENT_TEMPERATURE=0
NOVEL_AGENT_MAX_STEPS=16
# Extra attempts after an invalid structured model response (0-5).
NOVEL_AGENT_STRUCTURED_RETRIES=2
