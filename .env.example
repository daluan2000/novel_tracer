# Required for the `ask` command.
OPENAI_API_KEY=replace-me

# Optional for OpenAI-compatible providers.
OPENAI_BASE_URL=
MODEL_NAME=gpt-4.1-mini

# DeepSeek thinking mode rejects the named tool choice used by structured
# output. DeepSeek models default to disabled; set explicitly when needed.
MODEL_THINKING_MODE=

# Optional runtime defaults.
NOVEL_AGENT_TEMPERATURE=0
NOVEL_AGENT_MAX_STEPS=16
# Extra attempts after an invalid structured model response (0-5).
NOVEL_AGENT_STRUCTURED_RETRIES=2
